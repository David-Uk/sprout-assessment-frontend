# Copy to .env. Vite exposes these variables to the browser — never put secrets here.
VITE_API_BASE_URL=http://localhost:3000/api

# Optional development proxy (alternative to CORS):
# set VITE_USE_DEV_PROXY=true and VITE_API_BASE_URL=/api
VITE_USE_DEV_PROXY=false
VITE_API_TARGET=http://localhost:3000
